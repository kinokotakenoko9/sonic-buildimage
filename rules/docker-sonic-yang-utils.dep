DPATH       := $($(DOCKER_YANG_UTILS)_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) rules/docker-sonic-yang-utils.mk rules/docker-sonic-yang-utils.dep   
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(DPATH))

$(DOCKER_YANG_UTILS)_CACHE_MODE  := GIT_CONTENT_SHA 
$(DOCKER_YANG_UTILS)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(DOCKER_YANG_UTILS)_DEP_FILES   := $(DEP_FILES)
